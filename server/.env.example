# Copy to .env and fill in. .env is never committed; on a host, set these
# in its environment settings instead.

# The PostgreSQL database. In development, `npm run dev` starts a local
# PostgreSQL 17 with exactly this user, password, port and database name
# (created on first run, files in server/data/postgres). Pick your own
# password. In production: the address your database host gives you.
DATABASE_URL=postgres://fundix:choose-a-password@localhost:5432/fundix

# The first admin console account. Used once, while no staff exist yet;
# after that, staff are managed from the console.
OWNER_EMAIL=you@example.com

# From Google Cloud Console > APIs & Services > Credentials >
# OAuth client ID (type: Web application).
GOOGLE_CLIENT_ID=

# Where the admin website runs. Changes from anywhere else are refused.
ADMIN_ORIGIN=http://localhost:5173

# DEVELOPMENT ONLY: "Sign in as owner" without Google, from this computer
# only. Ignored when NODE_ENV=production.
ADMIN_DEV_SIGN_IN=false

# DEVELOPMENT ONLY: the app's "simulated phone" answers M-Pesa PIN prompts
# until Daraja is connected. On unless set to false; always off when
# NODE_ENV=production.
SIMULATE_MPESA=true

# The iOS app's bundle id, for Sign in with Apple. Leave empty until the
# iOS app exists; Apple sign-in stays off.
APPLE_BUNDLE_ID=

# ---- M-Pesa (Safaricom Daraja) — docs/mpesa.md ----------------------------
# Leave all of these empty to use the simulator (development only; the
# server refuses to start in production without them). Never commit real
# values: this file is an example, server/.env is where they go.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Paybill (or a till's store number) that receives customer payments.
MPESA_SHORTCODE=
MPESA_PASSKEY=
# paybill or till; for a till also set MPESA_TILL_NUMBER.
MPESA_STK_TYPE=paybill
MPESA_TILL_NUMBER=
# Public https address of this server that Safaricom can reach, and a long
# random secret that goes into the callback addresses.
MPESA_CALLBACK_BASE_URL=
MPESA_CALLBACK_SECRET=
# Optional: only accept callbacks from these addresses (comma-separated).
MPESA_ALLOWED_IPS=
# B2C: mechanic payouts and customer refunds.
MPESA_B2C_SHORTCODE=
MPESA_B2C_INITIATOR_NAME=
MPESA_B2C_SECURITY_CREDENTIAL=

# ---- File storage (Cloudflare R2) — docs/files.md -------------------------
# Mechanic documents and photos, dispute evidence. Account ID and an API
# token with Object Read & Write on this bucket only. Check with
# `npm run files-check`.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fundix-dev
